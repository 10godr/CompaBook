# Copia este archivo a backend/.env para desarrollo local. Nunca subas el .env.
DATABASE_URL=postgresql+psycopg://compabook:compabook@localhost:5433/compabook          # app (en Vercel: pooler 6543)
DATABASE_URL_DIRECT=postgresql+psycopg://compabook:compabook@localhost:5433/compabook   # Alembic (en Supabase: 5432)
APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Clave del servidor para los códigos por correo. Genera una: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_DAYS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=25
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=CompaBook
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
INTERNAL_SECRET=
JOBS_MAX_PER_RUN=3
JOBS_BUDGET_SECONDS=30
DAILY_CONCEPT_LIMIT=30
DAILY_RETRY_LIMIT=10
CONCEPT_TITLE_MAX=200
LOG_LEVEL=INFO
